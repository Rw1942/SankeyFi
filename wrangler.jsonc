{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sankeyfi",
  "compatibility_date": "2026-11-22",

  // Served at https://sankeyfi.rick-wills.workers.dev (no custom domain). Version preview URLs stay on, as they were.
  "workers_dev": true,
  "preview_urls": true,

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
    "issues": { "enabled": true }
  },

  // Assets only, no Worker script: `npm run build` writes ./dist, and every unknown path serves index.html.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
